  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Bank Admin / Officer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"tenantId\": \"{{tenantId}}\",\r\n    \"username\": \"{{tenantAdminUsername}}\",\r\n    \"password\": \"{{tenantAdminPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Generated from cURL: curl -X POST \"{{baseUrl}}/api/v1/auth/login\" -H \"Content-Type: application/json\" -d '{\"tenantId\": \"\", \"username\": \"\", \"password\": \"\"}'"
          },
          "response": []
        },
        {
          "name": "Master Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"{{masterUsername}}\",\r\n    \"password\": \"{{masterPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/master/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "master",
                "login"
              ]
            },
            "description": "Generated from cURL: curl -X POST \"{{baseUrl}}/api/v1/auth/master/login\" -H \"Content-Type: application/json\" -d '{\"username\": \"\", \"password\": \"\"}'"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/reset-password",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "description": "JWT tenant and username are taken from the authenticated token. Body contains only currentPassword and newPassword."
          },
          "response": []
        }
      ]
    },
    {
